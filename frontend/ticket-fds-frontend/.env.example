# 서연 데모 백엔드(feat/#9/demo-backend)와 연동하려면 아래 두 값을 false 로:
#   VITE_USE_MOCK_BTS=false, VITE_USE_MOCK_TICKETING=false  (대기열·카드·QR은 백엔드에 없어 mock 유지)
# true: 티켓팅(공연·좌석·예매) mock 사용
VITE_USE_MOCK_TICKETING=true
# true: BTS API(사용자 등록, 이벤트 수집)도 mock 사용 (백엔드 없이 UI만 볼 때)
VITE_USE_MOCK_BTS=true
# 비워 두면 같은 origin(/api → vite proxy). 테스트 서버: https://api.dev-bts.com
VITE_API_BASE_URL=

# true: QR 화면 확인용 임시 QR 토큰 발급 (QR API 연동 전)
VITE_MOCK_QR=false

# true: 대기열 API(서연 Redis 대기열) 전에는 mock 사용 — 시간이 지나면 대기 번호가 줄어든다
VITE_USE_MOCK_QUEUE=true
# (선택) mock 대기열 시작 번호 고정. 0 이면 대기 없이 바로 입장. 비우면 4~9 사이 무작위
VITE_MOCK_QUEUE_START=

# true: 카드 등록 API 전에는 mock 사용 (끝 4자리만 브라우저에 저장)
VITE_USE_MOCK_CARDS=true
