# Copy to backend/.env and set separate random passwords; never commit that file.
# Spring does not automatically load .env. Use scripts/Invoke-Backend.ps1 or export variables.
DB_HOST=localhost
DB_PORT=3308
DB_USERNAME=demo_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SERVER_PORT=8080
JPA_SHOW_SQL=false
BTS_ENABLED=false
BTS_BASE_URL=
# Choose the assigned service ID before creating demo identities for real delivery.
BTS_SERVICE_ID=demo-ticketing
BTS_API_KEY=
HOLD_DURATION=PT5M
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
QUEUE_KEY_PREFIX=demo-ticketing:queue
QUEUE_CAPACITY=100
QUEUE_WAIT_TTL=PT30M
QUEUE_ADMIT_TTL=PT5M
QUEUE_EXPIRED_RETENTION=PT10M
