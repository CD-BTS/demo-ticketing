# true: 티켓팅(공연·좌석·예매) API가 아직 없으므로 mock 사용
VITE_USE_MOCK_TICKETING=true
# true: BTS API(사용자 등록, 이벤트 수집)도 mock 사용 (백엔드 없이 UI만 볼 때)
VITE_USE_MOCK_BTS=true
# 비워 두면 같은 origin(/api → vite proxy). 테스트 서버: https://api.dev-bts.com
VITE_API_BASE_URL=

# true: QR 화면 확인용 임시 QR 토큰 발급 (QR API 연동 전)
VITE_MOCK_QR=false
